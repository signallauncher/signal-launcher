# Signal Launcher reads these from the environment at build time (`npm run tauri dev` / `npm run tauri build`).
# The launcher does not load .env files itself: set them in your shell or CI secrets.
# Every value is optional; the matching feature is hidden or disabled without it.

# CurseForge API key issued to Signal Launcher (console.curseforge.com).
# Alternative: put it on the first line of src-tauri/curseforge-api.key (ignored by git).
SIGNAL_CF_API_KEY=
# Runtime override of the built-in CurseForge key, for development only.
CURSEFORGE_API_KEY=

# Azure application id approved by Mojang for Microsoft sign-in.
SIGNAL_MS_CLIENT_ID=

# Discord application id for Rich Presence.
SIGNAL_DISCORD_APP_ID=

# Alternative signal-api base URL (default: https://signallauncher.mooo.com).
SIGNAL_SERVER=
# Alternative updater feed (default: https://signallauncher.mooo.com/update.json).
SIGNAL_UPDATE_URL=

# Updater signing key, needed only for `npm run tauri build`.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
